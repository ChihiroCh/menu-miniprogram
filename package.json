{
  "name": "family-menu", "private": true, "version": "1.0.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm run dev -w apps/server",
    "dev:web": "npm run dev:h5 -w apps/client",
    "dev:mp": "npm run dev:mp-weixin -w apps/client",
    "build": "npm run build -w apps/server && npm run build:h5 -w apps/client && npm run build:mp-weixin -w apps/client",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w apps/server",
    "db:generate": "npm run db:generate -w apps/server",
    "db:migrate": "npm run db:migrate -w apps/server",
    "db:seed": "npm run db:seed -w apps/server"
  },
  "engines": { "node": ">=22" }
}
